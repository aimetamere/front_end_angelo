# Vite's bundles have a content hash in their names, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, fonts and icons rarely change: cache for 30 days.
/photos/web/*
  Cache-Control: public, max-age=2592000
/font/*
  Cache-Control: public, max-age=2592000
/icons/*
  Cache-Control: public, max-age=2592000
